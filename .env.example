# Serveur (apps/server). Toutes les valeurs sont optionnelles.
# Le serveur ne lit pas ce fichier tout seul : exporte ces variables
# (ou mets-les dans le service systemd, cf. docs/deploiement.md).
PORT=3001
HOST=0.0.0.0
# Base SQLite + fichiers des comptes : à sauvegarder
DATA_DIR=./data
MAX_UPLOAD_MB=200
MAX_EXPORT_MB=2048
# false = plus de nouveaux comptes (les comptes existants marchent toujours)
ALLOW_SIGNUP=true
SESSION_DAYS=60
# Historique : une version auto au plus toutes les N minutes, N dernières gardées
VERSION_INTERVAL_MINUTES=10
MAX_AUTO_VERSIONS=50
# Propositions de musique (onglet Musique) : clé « client_id » Jamendo, gratuite pour un
# usage non commercial (https://devportal.jamendo.com). Vide = désactivé.
JAMENDO_CLIENT_ID=
# NODE_ENV=production   → le serveur sert aussi l'éditeur buildé
